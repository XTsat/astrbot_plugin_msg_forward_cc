{
  "default_hide_header": {
    "description": "新建转发规则时，默认是否隐藏来源信息头。",
    "type": "bool",
    "hint": "开启后，通过 mf bind 新建的规则默认不显示来源信息。可通过 mf hide 随时切换。",
    "default": false
  },
  "rules": {
    "description": "转发规则",
    "type": "template_list",
    "hint": "定义消息转发规则。每条规则指定消息来源和目标。UMO 格式：平台名:消息类型:会话ID，如 aiocqhttp:GroupMessage:654321 或 aiocqhttp:FriendMessage:114514",
    "default": [],
    "templates": {
      "rule": {
        "name": "转发规则",
        "display_item": "remark",
        "hide_hint_in_list": true,
        "items": {
          "enabled": {
            "description": "启用此规则",
            "type": "bool",
            "hint": "关闭后此规则暂时停用，规则保留但不再转发消息。可通过 /mf toggle 或 WebUI 随时切换。",
            "default": true
          },
          "remark": {
            "description": "名称",
            "type": "string",
            "hint": "自定义备注，作为该规则的展示名称。",
            "default": ""
          },
          "source_umo": {
            "description": "源 UMO 列表",
            "type": "text",
            "hint": "消息来源会话标识，每行一条，可填多个（任一命中即触发转发）。GroupMessage（群聊）或 FriendMessage（私聊）。例如 aiocqhttp:GroupMessage:123456",
            "default": ""
          },
          "target_umo": {
            "description": "目标 UMO 列表",
            "type": "text",
            "hint": "消息目标会话标识，每行一条，可填多个，消息将转发到列表中的每个会话。GroupMessage（群聊）或 FriendMessage（私聊）。例如 aiocqhttp:GroupMessage:654321",
            "default": ""
          },
          "hide_header": {
            "description": "隐藏来源信息头",
            "type": "bool",
            "hint": "开启后转发时不显示来源信息头，消息直接透传。",
            "default": false
          },
          "filter_mode": {
            "description": "过滤模式",
            "type": "string",
            "hint": "仅对本规则生效。inherit=继承全局设置；off=不过滤；blacklist=黑名单；whitelist=白名单。",
            "default": "inherit",
            "options": ["inherit", "off", "blacklist", "whitelist"]
          },
          "filter_patterns": {
            "description": "过滤规则列表",
            "type": "list",
            "hint": "仅对本规则生效。每项格式：regex:正则表达式 或 关键词（默认）。如 regex:http 匹配含 http 的消息，广告 匹配含\"广告\"的消息（不区分大小写），留空继承全局设置。",
            "default": []
          },
          "cooldown_seconds": {
            "description": "转发冷却时间（秒）",
            "type": "int",
            "hint": "仅对本规则生效。转发一次后在该秒数内不再重复转发。0 或不填则继承全局默认值。",
            "default": 0
          },
          "download_media_before_send": {
            "description": "发送媒体前先下载到本地",
            "type": "string",
            "hint": "仅对本规则生效。inherit=继承全局设置；true=强制开启；false=强制关闭。",
            "default": "inherit",
            "options": ["inherit", "true", "false"]
          },
          "use_proxy": {
            "description": "媒体下载是否走代理",
            "type": "bool",
            "hint": "仅对本规则生效。关闭则直连；开启后 proxy_url 留空走 AstrBot 自带代理（系统环境变量），填写则走该代理地址。",
            "default": false
          },
          "proxy_url": {
            "description": "媒体下载代理地址",
            "type": "string",
            "hint": "仅 use_proxy 开启时生效。留空走 AstrBot 自带代理；填写则走该地址（如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080）。",
            "default": ""
          }
        }
      }
    }
  },
  "header_template": {
    "description": "来源信息头模板",
    "type": "text",
    "hint": "可用变量：{sender_name} 发送者昵称、{sender_id} 发送者ID、{platform} 平台名、{msg_type} 消息类型、{conversation_id} 会话ID。留空则使用默认格式。注意：消息头末尾会自动追加换行。",
    "default": "[转发] {sender_name} ({sender_id})\n来自 {platform} 的 {msg_type}（ID: {conversation_id}）消息"
  },
  "filter_mode": {
    "description": "消息过滤模式",
    "type": "string",
    "hint": "off=不过滤；blacklist=黑名单；whitelist=白名单。",
    "default": "off",
    "options": ["off", "blacklist", "whitelist"]
  },
  "filter_patterns": {
    "description": "全局过滤规则列表（每行一条）",
    "type": "text",
    "hint": "每行一条过滤规则。regex:正则表达式 表示正则匹配，其余为关键词匹配（不区分大小写）。可全选复制粘贴批量增删。",
    "default": ""
  },
  "default_cooldown_seconds": {
    "description": "默认转发冷却时间（秒）",
    "type": "int",
    "hint": "新建转发规则时的默认冷却间隔。转发一次后在该秒数内不再重复转发同一规则。每条规则可单独覆盖。",
    "default": 0
  },
  "download_media_before_send": {
    "description": "发送媒体前先下载到本地",
    "type": "bool",
    "hint": "正常不用开，跨设备转发提示找不到文件时再启用。开启后转发前会先把媒体存到本地再转发。",
    "default": false
  },
