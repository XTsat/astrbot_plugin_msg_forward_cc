{
  "rules": {
    "description": "转发规则",
    "type": "template_list",
    "hint": "按「源会话 → 目标会话」转发消息。一条规则可配多个源与多个目标，其余选项可按规则覆盖全局设置。",
    "default": [],
    "templates": {
      "rule": {
        "name": "转发规则",
        "display_item": "remark",
        "hide_hint_in_list": true,
        "items": {
          "enabled": {
            "description": "启用此规则",
            "type": "bool",
            "hint": "关闭后规则保留但不再转发，可用 /mf toggle 切换。",
            "default": true
          },
          "remark": {
            "description": "名称",
            "type": "string",
            "hint": "自定义备注，作为该规则的展示名称。",
            "default": ""
          },
          "source_umo": {
            "description": "源 UMO 列表",
            "type": "text",
            "hint": "来源会话，每行一条，可填多个。格式 平台:GroupMessage:群号（私聊用 FriendMessage）。",
            "default": ""
          },
          "target_umo": {
            "description": "目标 UMO 列表",
            "type": "text",
            "hint": "目标会话，每行一条，可填多个。格式 平台:GroupMessage:群号（私聊用 FriendMessage）。",
            "default": ""
          },
          "hide_header": {
            "description": "隐藏来源信息头",
            "type": "bool",
            "hint": "转发时不显示来源信息头。",
            "default": false
          },
          "filter_mode": {
            "description": "过滤模式",
            "type": "string",
            "hint": "仅本规则生效。继承全局 / 黑名单 / 白名单。",
            "default": "inherit",
            "options": [
              "inherit",
              "off",
              "blacklist",
              "whitelist"
            ],
            "labels": [
              "继承全局",
              "不过滤",
              "黑名单",
              "白名单"
            ]
          },
          "filter_patterns": {
            "description": "过滤规则列表",
            "type": "list",
            "hint": "仅本规则生效。每行一条，regex: 前缀为正则；留空继承全局。",
            "default": []
          },
          "sender_filter_mode": {
            "description": "用户黑白名单模式",
            "type": "string",
            "hint": "仅本规则生效。继承全局 / 黑名单 / 白名单；名单为空时不生效。",
            "default": "inherit",
            "options": [
              "inherit",
              "off",
              "blacklist",
              "whitelist"
            ],
            "labels": [
              "继承全局",
              "不过滤",
              "黑名单",
              "白名单"
            ]
          },
          "sender_filter_list": {
            "description": "用户名单",
            "type": "text",
            "hint": "仅本规则生效。每行一个 UID（见 /sid）；留空继承全局名单。",
            "default": ""
          },
          "cooldown_seconds": {
            "description": "转发冷却时间（秒）",
            "type": "int",
            "hint": "仅本规则生效，转发后该秒数内不重复转发。0=关闭；不填继承全局。",
            "default": 0
          },
          "queue_interval_seconds": {
            "description": "发送队列间隔（秒）",
            "type": "int",
            "hint": "仅本规则生效，每隔该秒数发一条。0=立即转发；不填继承全局。",
            "default": 0
          },
          "queue_max_size": {
            "description": "发送队列长度（条）",
            "type": "int",
            "hint": "仅本规则生效的积压上限，0=不限（仅受全局上限约束）。",
            "default": 0
          },
          "download_media_before_send": {
            "description": "发送媒体前先下载到本地",
            "type": "string",
            "hint": "仅本规则生效。继承全局 / 开启 / 关闭。",
            "default": "inherit",
            "options": [
              "inherit",
              "true",
              "false"
            ],
            "labels": [
              "继承全局",
              "开启",
              "关闭"
            ]
          },
          "content_types": {
            "description": "转发的内容类型",
            "type": "list",
            "hint": "仅本规则生效。未勾选的类型会被过滤；全不勾=继承全局；指令默认不转发。",
            "default": [],
            "render_type": "checkbox",
            "options": [
              "plain",
              "command",
              "image",
              "face",
              "record",
              "video",
              "file",
              "at",
              "other"
            ],
            "labels": [
              "文字",
              "指令",
              "图片",
              "表情",
              "语音",
              "视频",
              "文件",
              "@提及",
              "其他"
            ]
          },
          "at_nickname_lookup": {
            "description": "[增强] 高级 @：按昵称反查 @ 对象",
            "type": "string",
            "hint": "仅本规则生效。继承全局 / 开启 / 关闭。",
            "default": "inherit",
            "options": [
              "inherit",
              "true",
              "false"
            ],
            "labels": [
              "继承全局",
              "开启",
              "关闭"
            ]
          },
          "use_proxy": {
            "description": "媒体下载是否走代理",
            "type": "bool",
            "hint": "仅本规则生效。开启后留空走 AstrBot 自带代理，填写则走该地址。",
            "default": false
          },
          "proxy_url": {
            "description": "媒体下载代理地址",
            "type": "string",
            "hint": "仅开启代理时生效，如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080。",
            "default": ""
          }
        }
      }
    }
  },
  "basic": {
    "description": "基础设置",
    "type": "object",
    "hint": "新建规则时的默认来源信息头与内容类型。",
    "items": {
      "default_hide_header": {
        "description": "新建转发规则时，默认是否隐藏来源信息头。",
        "type": "bool",
        "hint": "新建规则默认隐藏来源信息头，可随时用 /mf hide 切换。",
        "default": false
      },
      "header_template": {
        "description": "来源信息头模板",
        "type": "text",
        "hint": "可用变量：{sender_name} {sender_id} {platform} {msg_type} {conversation_id}，留空用默认格式。",
        "default": "[转发] {sender_name} ({sender_id})\n来自 {platform} 的 {msg_type}（ID: {conversation_id}）消息"
      },
      "default_content_types": {
        "description": "默认转发的内容类型",
        "type": "list",
        "hint": "新建规则默认转发的内容类型。指令消息默认不转发，需要时勾「指令」。",
        "default": [
          "plain",
          "image",
          "face",
          "record",
          "video",
          "file",
          "at",
          "other"
        ],
        "render_type": "checkbox",
        "options": [
          "plain",
          "command",
          "image",
          "face",
          "record",
          "video",
          "file",
          "at",
          "other"
        ],
        "labels": [
          "文字",
          "指令",
          "图片",
          "表情",
          "语音",
          "视频",
          "文件",
          "@提及",
          "其他"
        ]
      }
    }
  },
  "forward": {
    "description": "聊天记录转发",
    "type": "object",
    "hint": "合并转发（聊天记录）展开时的行为。",
    "items": {
      "forward_keep_time": {
        "description": "转发聊天记录时保留原始发送时间",
        "type": "bool",
        "hint": "聊天记录显示原本的发送时间；关闭则显示转发时间。",
        "default": true
      },
      "forward_send_mode": {
        "description": "合并记录的发送方式",
        "type": "string",
        "options": ["auto", "native", "rebuild"],
        "labels": ["自动（推荐）", "优先原生", "优先重建"],
        "default": "auto",
        "hint": "自动：能原生转发就原生（最快、发送者与嵌套层数最完整），记录里有能还原的聊天记录卡片时改走重建把内层还原；优先原生：始终先让协议端搬运，不因卡片改走重建（内层卡片可能显示成「[XML消息]」）；优先重建：逐条重写，跨平台或需要严格按内容类型筛选时用，卡片会尽量还原、取不回时原样发卡片。"
      },
      "forward_native_relay": {
        "description": "优先用协议端原生转发合并记录（已并入「合并记录的发送方式」）",
        "type": "bool",
        "invisible": true,
        "hint": "旧开关，仅用于升级时迁移，请改用「合并记录的发送方式」。",
        "default": true
      },
      "forward_card_auto_rebuild": {
        "description": "记录含聊天记录卡片时自动重建（已并入「合并记录的发送方式」）",
        "type": "bool",
        "invisible": true,
        "hint": "旧开关，仅用于升级时迁移，请改用「合并记录的发送方式」。",
        "default": true
      },
      "forward_node_avatar": {
        "description": "[增强] 转发聊天记录时获取发送者头像",
        "type": "bool",
        "hint": "按昵称反查真实 QQ 号，让记录显示发送者头像；昵称重名或已改名时补不回来。",
        "default": true
      },
      "forward_card_preview": {
        "description": "聊天记录卡片预览",
        "type": "string",
        "hint": "卡片在预览行的显示方式。默认「来源 + 标题」，与 QQ 原生一致。",
        "default": "source",
        "options": [
          "source",
          "title",
          "off"
        ],
        "labels": [
          "来源 + 标题（原样）",
          "仅标题",
          "不显示（[卡片消息]）"
        ]
      },
      "forward_total_layers": {
        "description": "聊天记录最多保留几层",
        "type": "int",
        "hint": "含最外层记录在内的总层数，默认 3 = 你转发的这条 + 里面套的两层。协议端对超过 3 层的处理不同：NapCat 会静默丢弃更深的记录，SnowLuma 会让整条转发失败，LLOneBot 不校验层数，因此填大于 3 的效果取决于目标协议端。填 1 表示只保留最外层，里面的记录显示为 [聊天记录] 文字。",
        "default": 3,
        "slider": {
          "min": 1,
          "max": 10,
          "step": 1
        }
      },
      "forward_max_depth": {
        "description": "聊天记录嵌套展开层数（旧值，已改为总层数）",
        "type": "int",
        "invisible": true,
        "hint": "旧开关，仅用于升级时迁移到「聊天记录最多保留几层」，无需手动处理。",
        "default": 2
      }
    }
  },
  "filter": {
    "description": "过滤与名单",
    "type": "object",
    "hint": "按消息内容与发送者过滤，规则级设置可覆盖此处全局值。",
    "items": {
      "filter_mode": {
        "description": "消息过滤模式",
        "type": "string",
        "hint": "黑名单=命中则不转发；白名单=命中才转发。",
        "default": "off",
        "options": [
          "off",
          "blacklist",
          "whitelist"
        ],
        "labels": [
          "不过滤",
          "黑名单",
          "白名单"
        ]
      },
      "filter_patterns": {
        "description": "全局过滤规则列表（每行一条）",
        "type": "text",
        "hint": "每行一条。regex: 前缀为正则，其余按关键词匹配（不区分大小写）。",
        "default": ""
      },
      "sender_filter_mode": {
        "description": "用户黑白名单模式",
        "type": "string",
        "hint": "按发送者 UID 过滤：黑名单不转发，白名单只转发。名单为空时不生效。",
        "default": "off",
        "options": [
          "off",
          "blacklist",
          "whitelist"
        ],
        "labels": [
          "不过滤",
          "黑名单",
          "白名单"
        ]
      },
      "sender_filter_list": {
        "description": "全局用户名单（每行一条）",
        "type": "text",
        "hint": "每行一个 UID（见 /sid）。多适配器同号时写 BotID:UID；留空不按用户过滤。",
        "default": ""
      }
    }
  },
  "queue": {
    "description": "发送节奏（队列与冷却）",
    "type": "object",
    "hint": "控制消息发送的节奏：队列用于逐条限速并持久化积压，冷却用于丢弃短时间内的重复消息。两者都作用于单条规则，可按规则覆盖。",
    "items": {
      "queue_enabled": {
        "description": "发送队列总开关（默认开启）",
        "type": "bool",
        "hint": "规则设置了队列间隔即按间隔逐条发送。关闭后所有规则立即转发，可作紧急刹车。",
        "default": true
      },
      "default_queue_interval_seconds": {
        "description": "默认发送队列间隔（秒）",
        "type": "int",
        "hint": "新建规则的默认队列间隔，每隔该秒数发一条；0=立即转发。",
        "default": 0
      },
      "default_cooldown_seconds": {
        "description": "默认转发冷却时间（秒）",
        "type": "int",
        "hint": "新建规则的默认冷却秒数，转发后该时间内不重复转发。",
        "default": 0
      },
      "queue_max_size": {
        "description": "发送队列总长度上限",
        "type": "int",
        "hint": "全部规则合计的积压上限，超出则丢弃新消息；0=不限制。",
        "default": 0
      },
      "queue_media_retention_hours": {
        "description": "队列媒体缓存保留时间（小时）",
        "type": "int",
        "hint": "队列媒体缓存保留小时数，0=默认 24；重启时全部清理。",
        "default": 24
      }
    }
  },
  "enhance": {
    "description": "增强功能",
    "type": "object",
    "hint": "按需开启的增强项，默认值即可满足大多数场景。",
    "items": {
      "download_media_before_send": {
        "description": "发送媒体前先下载到本地",
        "type": "bool",
        "hint": "正常不用开，跨设备转发提示找不到文件时再启用。",
        "default": false
      },
      "at_nickname_lookup": {
        "description": "[增强] 高级 @：按昵称反查 @ 对象（默认关闭=At 转文本）",
        "type": "bool",
        "hint": "把 @昵称 反查为真实成员后精确 @，群大时稍慢；仅 QQ 系有效。",
        "default": false
      },
      "at_nickname_lookup_cache_ttl": {
        "description": "@ 昵称反查的群成员缓存时长（秒）",
        "type": "int",
        "hint": "群成员列表缓存秒数，0=每次重新拉取。默认 300。",
        "default": 300
      },
      "at_passthrough_extra_platforms": {
        "description": "额外允许 @ 透传的目标平台",
        "type": "list",
        "hint": "自建 QQ 适配器在此填平台名（每行一个），让 @ 按 qq 透传；跨平台不要填。",
        "default": []
      },
      "platform_names": {
        "description": "平台名称映射",
        "type": "list",
        "hint": "每项「原始平台名=显示名」，如 aiocqhttp=QQ；未命中的保持原名。",
        "default": [
          "default=默认",
          "aiocqhttp=QQ",
          "qq_official=QQ官方机器人",
          "qq_official_webhook=QQ官方机器人(Webhook)",
          "telegram=Telegram",
          "weixin_oc=个人微信",
          "wecom=企业微信",
          "weixin_official_account=微信公众号",
          "lark=飞书",
          "dingtalk=钉钉",
          "discord=Discord",
          "kook=KOOK",
          "slack=Slack",
          "vocechat=VoceChat",
          "line=LINE",
          "satori=Satori",
          "matrix=Matrix",
          "mattermost=Mattermost",
          "misskey=Misskey",
          "wecom_ai_bot=企微AI机器人"
        ]
      }
    }
  },
